# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Python files
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.tar.gz binary
*.whl binary
